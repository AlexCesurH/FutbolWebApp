37829>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37829>>>                Case Break
37830>>>
37830>>>            Case Else // must be nfUndefined
37830>>>
37830>>>        Case End
37830>>>
37830>>>        Send SetActionButtons
