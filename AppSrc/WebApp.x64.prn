37788>>>    Procedure SetActionButtons
37791>>>        tWebNavigateData NavigateData
37791>>>        tWebNavigateData NavigateData
37791>>>        Boolean bHasRecord
37791>>>        Handle hoDD
37791>>>
37791>>>        Get Server to hoDD
37792>>>        Get GetNavigateData to NavigateData
37793>>>        Get HasRecord of hoDD to bHasRecord
37794>>>
37794>>>        // let's hide all buttons and then Show the ones we want
37794>>>        WebSet pbRender of oEditBtn to False
37795>>>        WebSet pbRender of oSaveBtn to False
37796>>>        WebSet pbRender of oCancelChangesBtn to False
37797>>>        WebSet pbRender of oDeleteBtn to False
37798>>>
37798>>>        If (NavigateData.bReadOnly) Begin
37800>>>            WebSet pbRender of oEditBtn to True
37801>>>        End
37801>>>>
37801>>>        Else Begin
37802>>>            WebSet pbRender of oSaveBtn to True
37803>>>            WebSet pbRender of oCancelChangesBtn to True
37804>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37805>>>        End
37805>>>>
37805>>>    End_Procedure
