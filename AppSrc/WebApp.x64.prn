38364>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38367>>>        Case Begin
38367>>>            Case (NavigateData.eNavigateType = nfFromMain)
38369>>>                // If from main, this is a propbably a main file Select to Zoom.
38369>>>                Case Break
38370>>>
38370>>>            Case (NavigateData.eNavigateType = nfFromParent)
38373>>>                // If from parent, this is a constrained drill down.
38373>>>                Case Break
38374>>>
38374>>>            Case (NavigateData.eNavigateType = nfFromChild)
38377>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38377>>>                Case Break
38378>>>
38378>>>            Case Else // must be nfUndefined
38378>>>
38378>>>        Case End
38378>>>
38378>>>        Send SetActionButtons
38379>>>
38379>>>    End_Procedure
38380>>>
38380>>>End_Object 
