38336>>>    Procedure SetActionButtons
38339>>>        tWebNavigateData NavigateData
38339>>>        tWebNavigateData NavigateData
38339>>>        Boolean bHasRecord
38339>>>        Handle hoDD
38339>>>
38339>>>        Get Server to hoDD
38340>>>        Get GetNavigateData to NavigateData
38341>>>        Get HasRecord of hoDD to bHasRecord
38342>>>
38342>>>        // let's hide all buttons and then Show the ones we want
38342>>>        WebSet pbRender of oEditBtn to False
38343>>>        WebSet pbRender of oSaveBtn to False
38344>>>        WebSet pbRender of oCancelChangesBtn to False
38345>>>        WebSet pbRender of oDeleteBtn to False
38346>>>
38346>>>        If (NavigateData.bReadOnly) Begin
38348>>>            WebSet pbRender of oEditBtn to True
38349>>>        End
38349>>>>
38349>>>        Else Begin
38350>>>            WebSet pbRender of oSaveBtn to True
38351>>>            WebSet pbRender of oCancelChangesBtn to True
38352>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38353>>>        End
38353>>>>
38353>>>    End_Procedure
38354>>>
38354>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38357>>>        // Close after save
38357>>>        Send NavigateClose Self
38358>>>    End_Procedure
38359>>>
38359>>>    // this will close the view after a delete
38359>>>    Procedure OnViewDeleted Handle hoDDO
38362>>>        Send NavigateClose Self
38363>>>    End_Procedure
